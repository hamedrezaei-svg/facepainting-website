<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Mary's Face Art | Vancouver · Langley · Surrey</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --teal: #00C9B1;
      --teal-dark: #00A896;
      --teal-light: #7EECD8;
      --coral: #FF6B6B;
      --yellow: #FFD93D;
      --purple: #C77DFF;
      --dark: #F8FFFE;
      --dark2: #EDF9F7;
      --white: #FFFFFF;
      --light: #F0FFFE;
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Nunito', sans-serif; background: var(--dark); color: #1A1A2E; overflow-x: hidden; }

    /* NAV */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.2rem 4rem;
      background: rgba(248,255,254,0.95);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(0,201,177,0.2);
    }
    .logo { font-family: 'Playfair Display', serif; font-size: 1.6rem; color: #1A3340; }
    .logo span { color: var(--teal); font-style: italic; }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a { text-decoration: none; font-size: 0.85rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #4A6670; transition: color 0.3s; }
    .nav-links a:hover { color: var(--teal); }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(0,201,177,0.15) 0%, transparent 70%);
      top: -100px; left: -100px;
      pointer-events: none;
    }
    .hero-left {
      display: flex; flex-direction: column; justify-content: center;
      padding: 8rem 4rem 4rem 5rem;
      position: relative; z-index: 2;
    }
    .hero-tag {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: rgba(0,201,177,0.15);
      border: 1px solid rgba(0,201,177,0.4);
      color: var(--teal);
      padding: 0.5rem 1.2rem; border-radius: 50px;
      font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; text-transform: uppercase;
      margin-bottom: 2rem; width: fit-content;
      animation: fadeUp 0.8s ease both;
    }
    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(3rem, 5vw, 5rem);
      line-height: 1.05; margin-bottom: 1.5rem;
      animation: fadeUp 0.8s 0.1s ease both;
    }
    .hero h1 em { font-style: italic; color: var(--teal); }
    .hero-desc {
      font-size: 1.05rem; color: #4A6670;
      line-height: 1.85; max-width: 420px; margin-bottom: 2.5rem;
      animation: fadeUp 0.8s 0.2s ease both;
    }
    .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; animation: fadeUp 0.8s 0.3s ease both; }
    .btn-primary {
      background: linear-gradient(135deg, var(--teal), var(--teal-dark));
      color: var(--dark); padding: 1rem 2.2rem; border-radius: 50px;
      text-decoration: none; font-weight: 800; font-size: 0.9rem; letter-spacing: 1px;
      box-shadow: 0 8px 30px rgba(0,201,177,0.4);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 14px 40px rgba(0,201,177,0.5); }
    .btn-secondary {
      border: 2px solid rgba(255,255,255,0.3); color: #1A3340;
      padding: 1rem 2.2rem; border-radius: 50px;
      text-decoration: none; font-weight: 800; font-size: 0.9rem;
      transition: all 0.2s;
    }
    .btn-secondary:hover { border-color: var(--teal); color: var(--teal); }

    /* HERO RIGHT */
    .hero-right {
      position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .hero-right-bg {
      position: absolute; inset: 0;
      background: linear-gradient(135deg, #0F3460 0%, #1A1A2E 40%, #00A896 100%);
    }
    .hero-circles {
      position: relative; z-index: 2;
      width: 400px; height: 400px;
    }
    .circle-ring {
      position: absolute; border-radius: 50%;
      border: 2px solid rgba(0,201,177,0.3);
      animation: spin 20s linear infinite;
    }
    .circle-ring:nth-child(1) { width: 380px; height: 380px; top: 10px; left: 10px; }
    .circle-ring:nth-child(2) { width: 300px; height: 300px; top: 50px; left: 50px; animation-duration: 15s; animation-direction: reverse; border-color: rgba(255,107,107,0.3); }
    .circle-ring:nth-child(3) { width: 220px; height: 220px; top: 90px; left: 90px; animation-duration: 10s; border-color: rgba(255,217,61,0.3); }
    .hero-center-icon {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      z-index: 3; text-align: center;
    }
    .hero-center-icon .big-emoji { font-size: 6rem; display: block; animation: float 3s ease-in-out infinite; }
    .hero-center-icon p { font-size: 0.8rem; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; color: var(--teal); margin-top: 0.5rem; }
    .float-item {
      position: absolute; z-index: 3;
      background: rgba(255,255,255,0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 16px; padding: 0.7rem 1rem;
      font-size: 0.8rem; font-weight: 700;
      animation: float 4s ease-in-out infinite;
    }
    .float-item:nth-child(4) { top: 15%; left: 5%; animation-delay: 0s; }
    .float-item:nth-child(5) { top: 20%; right: 5%; animation-delay: 1s; }
    .float-item:nth-child(6) { bottom: 25%; left: 8%; animation-delay: 2s; }
    .float-item:nth-child(7) { bottom: 15%; right: 8%; animation-delay: 0.5s; }

    /* MARQUEE */
    .marquee-wrap { background: var(--teal); padding: 0.9rem 0; overflow: hidden; }
    .marquee-inner { display: inline-block; animation: marquee 25s linear infinite; white-space: nowrap; }
    .marquee-inner span { color: var(--dark); font-weight: 800; font-size: 0.8rem; letter-spacing: 3px; text-transform: uppercase; padding: 0 2rem; }
    .marquee-inner span::before { content: '✦'; margin-right: 2rem; }

    /* SECTIONS */
    .section-label { font-size: 0.72rem; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; color: var(--teal); margin-bottom: 0.7rem; }
    .section-title { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3vw, 2.8rem); color: #1A3340; line-height: 1.2; }

    /* SERVICES */
    .services { padding: 7rem 5rem; background: var(--dark2); }
    .services .section-title { margin-bottom: 3.5rem; }
    .services-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1.5rem; }
    .service-card {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(0,201,177,0.15);
      border-radius: 24px; padding: 2.5rem 1.8rem;
      transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
      position: relative; overflow: hidden;
    }
    .service-card::before {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(0,201,177,0.05), transparent);
      opacity: 0; transition: opacity 0.3s;
    }
    .service-card:hover { transform: translateY(-8px); border-color: rgba(0,201,177,0.5); box-shadow: 0 20px 50px rgba(0,201,177,0.1); }
    .service-card:hover::before { opacity: 1; }
    .service-icon { font-size: 2.8rem; margin-bottom: 1.2rem; }
    .service-card h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: #1A3340; margin-bottom: 0.7rem; }
    .service-card p { font-size: 0.88rem; color: #5A7070; line-height: 1.75; }

    /* GALLERY */
    .gallery { padding: 7rem 5rem; background: var(--dark); }
    .gallery .section-title { margin-bottom: 3rem; }
    .gallery-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 260px 260px; gap: 1rem; }
    .gallery-item { border-radius: 18px; overflow: hidden; position: relative; cursor: pointer; }
    .gallery-item:first-child { grid-row: 1 / 3; }
    .gallery-inner { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 5rem; transition: transform 0.5s; }
    .gallery-item:hover .gallery-inner { transform: scale(1.07); }
    .g1 { background: linear-gradient(135deg, #00C9B1, #0F3460); }
    .g2 { background: linear-gradient(135deg, #FF6B6B, #C77DFF); }
    .g3 { background: linear-gradient(135deg, #FFD93D, #FF6B6B); }
    .g4 { background: linear-gradient(135deg, #C77DFF, #0F3460); }
    .g5 { background: linear-gradient(135deg, #00C9B1, #C77DFF); }
    .gallery-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent); opacity: 0; transition: opacity 0.3s; display: flex; align-items: flex-end; padding: 1.5rem; }
    .gallery-item:hover .gallery-overlay { opacity: 1; }
    .gallery-overlay span { color: white; font-weight: 800; font-size: 0.9rem; letter-spacing: 1px; }

    /* ABOUT */
    .about { padding: 7rem 5rem; background: var(--dark2); display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: center; }
    .about-visual { position: relative; }
    .about-img-wrap {
      border-radius: 30px; overflow: hidden; height: 500px;
      box-shadow: 0 30px 80px rgba(0,201,177,0.2);
      border: 1px solid rgba(0,201,177,0.3);
    }
    .about-img-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
    .about-badge {
      position: absolute; bottom: -20px; right: -20px;
      background: linear-gradient(135deg, var(--teal), var(--teal-dark));
      color: var(--dark); border-radius: 20px; padding: 1.2rem 1.5rem;
      text-align: center; box-shadow: 0 10px 30px rgba(0,201,177,0.4);
    }
    .about-badge strong { display: block; font-size: 2rem; font-family: 'Playfair Display', serif; }
    .about-badge span { font-size: 0.72rem; letter-spacing: 1px; font-weight: 800; }
    .about-content .section-title { margin-bottom: 1.5rem; margin-top: 0.5rem; }
    .about-content p { color: #4A6670; line-height: 1.9; font-size: 1rem; margin-bottom: 1.5rem; }
    .about-tags { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2rem; }
    .tag { background: rgba(0,201,177,0.1); color: var(--teal); padding: 0.4rem 1rem; border-radius: 50px; font-size: 0.8rem; font-weight: 800; border: 1px solid rgba(0,201,177,0.3); }

    /* CONTACT */
    .contact { padding: 7rem 5rem; background: var(--dark); position: relative; overflow: hidden; }
    .contact::before { content: ''; position: absolute; width: 500px; height: 500px; background: radial-gradient(circle, rgba(0,201,177,0.08) 0%, transparent 70%); bottom: -100px; right: -100px; pointer-events: none; }
    .contact-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
    .contact .section-title { margin-bottom: 2rem; margin-top: 0.5rem; }
    .contact-items { display: flex; flex-direction: column; gap: 1.2rem; }
    .contact-item { display: flex; align-items: center; gap: 1rem; color: #3A5560; }
    .contact-item-icon { width: 46px; height: 46px; background: rgba(0,201,177,0.15); border: 1px solid rgba(0,201,177,0.3); border-radius: 13px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
    .areas { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1.5rem; }
    .area-tag { background: rgba(0,201,177,0.1); color: var(--teal); padding: 0.4rem 0.9rem; border-radius: 50px; font-size: 0.8rem; font-weight: 700; border: 1px solid rgba(0,201,177,0.2); }
    .contact-card { background: rgba(255,255,255,0.04); border-radius: 24px; padding: 3rem; border: 1px solid rgba(0,201,177,0.2); }
    .contact-card p { color: #4A6670; font-size: 1.05rem; line-height: 1.8; margin-bottom: 2rem; font-family: 'Playfair Display', serif; font-style: italic; }
    .qr-wrap { display: flex; flex-direction: column; align-items: center; gap: 1rem; margin-bottom: 2rem; }
    .qr-wrap img { width: 160px; height: 160px; border-radius: 16px; border: 2px solid rgba(0,201,177,0.3); }
    .qr-wrap a { color: var(--teal); text-decoration: none; font-weight: 800; font-size: 0.9rem; }

    /* FOOTER */
    footer { background: #0D0D1A; color: rgba(255,255,255,0.3); text-align: center; padding: 2rem; font-size: 0.85rem; }
    footer strong { color: var(--teal); }

    /* ANIMATIONS */
    @keyframes fadeUp { from { opacity:0; transform:translateY(25px); } to { opacity:1; transform:translateY(0); } }
    @keyframes float { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-15px); } }
    @keyframes marquee { from { transform:translateX(0); } to { transform:translateX(-50%); } }
    @keyframes spin { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }
    .reveal { opacity:0; transform:translateY(30px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal.visible { opacity:1; transform:translateY(0); }

    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; }
      .hero-right { height: 320px; }
      .hero-left { padding: 7rem 2rem 3rem; }
      .services-grid { grid-template-columns: 1fr 1fr; }
      .gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
      .gallery-item:first-child { grid-row: auto; }
      .about, .contact-inner { grid-template-columns: 1fr; gap: 3rem; }
      nav { padding: 1rem 1.5rem; }
      .services, .gallery, .about, .contact { padding: 4rem 1.5rem; }
      .hero-circles { width: 280px; height: 280px; }
      .circle-ring:nth-child(1) { width: 260px; height: 260px; }
      .circle-ring:nth-child(2) { width: 200px; height: 200px; top: 30px; left: 30px; }
      .circle-ring:nth-child(3) { width: 140px; height: 140px; top: 60px; left: 60px; }
    }
  </style>
</head>
<body>

  <nav>
    <div class="logo">Mary's <span>Face Art</span></div>
    <ul class="nav-links">
      <li><a href="#services">Services</a></li>
      <li><a href="#gallery">Gallery</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>

  <section class="hero">
    <div class="hero-left">
      <div class="hero-tag">✦ Serving Metro Vancouver</div>
      <h1>Where Art Meets<br><em>Little Faces</em></h1>
      <p class="hero-desc">Professional face painting that transforms children and adults into magical creatures, superheroes, and works of art — for every special occasion.</p>
      <div class="hero-btns">
        <a href="#contact" class="btn-primary">Book Your Event 🎉</a>
        <a href="#gallery" class="btn-secondary">See My Work</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-right-bg"></div>
      <div class="hero-circles">
        <div class="circle-ring"></div>
        <div class="circle-ring"></div>
        <div class="circle-ring"></div>
        <div class="hero-center-icon">
          <span class="big-emoji">🎨</span>
          <p>Face Art Magic</p>
        </div>
      </div>
      
    </div>
  </section>

  <div class="marquee-wrap">
    <div class="marquee-inner">
      <span>Birthday Parties</span><span>Festivals</span><span>School Events</span>
      <span>Weddings</span><span>Corporate Events</span><span>Baby Showers</span>
      <span>Birthday Parties</span><span>Festivals</span><span>School Events</span>
      <span>Weddings</span><span>Corporate Events</span><span>Baby Showers</span>
    </div>
  </div>

  <section class="services" id="services">
    <div class="section-label">What I offer</div>
    <h2 class="section-title">Services for Every<br>Special Occasion</h2>
    <div class="services-grid">
      <div class="service-card reveal">
        <div class="service-icon">🎂</div>
        <h3>Birthday Parties</h3>
        <p>Make your child's birthday truly magical with professional face art everyone will remember.</p>
      </div>
      <div class="service-card reveal">
        <div class="service-icon">🎪</div>
        <h3>Festivals & Fairs</h3>
        <p>High-volume face painting for community events, fairs, and large gatherings.</p>
      </div>
      <div class="service-card reveal">
        <div class="service-icon">🏫</div>
        <h3>School Events</h3>
        <p>Safe, fun face painting for school fairs, fundraisers, and end-of-year celebrations.</p>
      </div>
      <div class="service-card reveal">
        <div class="service-icon">💍</div>
        <h3>Special Occasions</h3>
        <p>Weddings, baby showers, corporate events, and any private celebration.</p>
      </div>
    </div>
  </section>

  <section class="gallery" id="gallery">
    <div class="section-label">Portfolio</div>
    <h2 class="section-title">A Glimpse of My Work</h2>
    <div class="gallery-grid">
      <div class="gallery-item reveal"><div class="gallery-inner g1">🦋</div><div class="gallery-overlay"><span>Butterfly Fantasy</span></div></div>
      <div class="gallery-item reveal"><div class="gallery-inner g2">🦁</div><div class="gallery-overlay"><span>Lion King</span></div></div>
      <div class="gallery-item reveal"><div class="gallery-inner g3">🌸</div><div class="gallery-overlay"><span>Spring Blossom</span></div></div>
      <div class="gallery-item reveal"><div class="gallery-inner g4">🐉</div><div class="gallery-overlay"><span>Dragon Fire</span></div></div>
      <div class="gallery-item reveal"><div class="gallery-inner g5">⭐</div><div class="gallery-overlay"><span>Starlight</span></div></div>
    </div>
  </section>

  <section class="about" id="about">
    <div class="about-visual reveal">
      <div class="about-img-wrap">
        <img src="/mary.jpg" alt="Mary - Face Artist" />
      </div>
      <div class="about-badge">
        <strong>5+</strong>
        <span>Years Experience</span>
      </div>
    </div>
    <div class="about-content">
      <div class="section-label">About the artist</div>
      <h2 class="section-title">Hi, I'm Mary —<br><em style="color:var(--teal);font-style:italic;">Your Local Face Artist</em></h2>
      <p>I'm a passionate face painter based in Metro Vancouver with a love for bringing smiles and wonder to people of all ages. Every face is a canvas and every event is a chance to create something truly magical.</p>
      <p>I use only professional-grade, hypoallergenic, skin-safe paints — completely safe for kids and adults alike.</p>
      <div class="about-tags">
        <span class="tag">✓ Skin-safe paints</span>
        <span class="tag">✓ All ages welcome</span>
        <span class="tag">✓ Fully insured</span>
        <span class="tag">✓ Fast & friendly</span>
      </div>
      <a href="#contact" class="btn-primary">Let's Work Together ✨</a>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="contact-inner">
      <div>
        <div class="section-label">Get in touch</div>
        <h2 class="section-title">Ready to Make<br>Magic Happen?</h2>
        <div class="contact-items">
          <div class="contact-item">
            <div class="contact-item-icon">📱</div>
            <span style="color:#1A3340;">+1 (778) 238-7507</span>
          </div>
          <div class="contact-item" style="flex-direction:column; align-items:flex-start; gap:0.8rem;">
            <div class="qr-wrap">
              <a href="https://www.instagram.com/marysfacepainting.langley?utm_source=qr" target="_blank">
                <img src="/qr-instagram.jpg" alt="Instagram QR Code" />
              </a>
              <a href="https://www.instagram.com/marysfacepainting.langley?utm_source=qr" target="_blank">@marysfacepainting.langley</a>
            </div>
          </div>
        </div>
        <div class="areas">
          <span class="area-tag">📍 Metro Vancouver</span>
          <span class="area-tag">📍 Langley</span>
          <span class="area-tag">📍 Surrey</span>
        </div>
      </div>
      <div class="contact-card reveal">
        <p>"Every face tells a story — let me help yours shine at your next event!"</p>
        <a href="tel:+17782387507" class="btn-primary">Call to Book 📞</a>
      </div>
    </div>
  </section>

  <footer>
    <p>© 2025 <strong>Mary's Face Art</strong> · Metro Vancouver · Langley · Surrey, BC · Made with ❤️</p>
  </footer>

  <script>
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver(entries => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) setTimeout(() => entry.target.classList.add('visible'), i * 120);
      });
    }, { threshold: 0.1 });
    reveals.forEach(el => observer.observe(el));
  </script>
</body>
</html>
